<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    parallel="tests"  => Chrome and Edge run at the same time
    thread-count="2"  => 2 threads, one per browser
-->
<suite name="GUI Elements Test Suite" parallel="tests" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.guielements.utils.ExtentReportManager"/>
    </listeners>

    <!-- Chrome Browser Test -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.guielements.tests.GUIElementsTest"/>
        </classes>
    </test>

    <!-- Edge Browser Test — runs in parallel with Chrome -->
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.guielements.tests.GUIElementsTest"/>
        </classes>
    </test>

</suite>
